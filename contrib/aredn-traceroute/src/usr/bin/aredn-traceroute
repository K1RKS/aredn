#!/usr/bin/ucode
/*
 * AREDN enriched traceroute CLI — link type, Babel cost/metric; optional GPS.
 */

import * as atr from "aredn_traceroute";
import * as configuration from "aredn.configuration";

function usage()
{
    print("Usage: aredn-traceroute [-verbose] [-gps] <destination>\n");
    print("  Runs traceroute and appends per-hop link type, tx/rx cost, success, metric, errors.\n");
    print("  Link type/cost/success/errors come from the previous hop's LQM (route-specific).\n");
    print("  Each node is queried at most once via /a/sysinfo?lqm=1.\n");
    print("  Header shows start node, destination, and Babel path metric.\n");
    print("  -gps       Include per-hop GPS coordinates (off by default).\n");
    print("  -verbose   Explain why any type/cost/success/metric/errors (and GPS if -gps) fields are unset (-).\n");
};

let verbose = false;
let gps = false;
let dest = null;
for (let i = 0; i < length(ARGV); i++) {
    const a = ARGV[i];
    if (a === "-h" || a === "--help") {
        usage();
        exit(0);
    }
    if (a === "-verbose" || a === "--verbose" || a === "-v") {
        verbose = true;
        continue;
    }
    if (a === "-gps" || a === "--gps") {
        gps = true;
        continue;
    }
    if (match(a, /^-/)) {
        print(`Unknown option: ${a}\n`);
        usage();
        exit(1);
    }
    if (dest) {
        print("Only one destination is allowed\n");
        usage();
        exit(1);
    }
    dest = a;
}

if (!dest) {
    usage();
    exit(1);
}

if (match(dest, /[^0-9a-zA-Z.\-]/)) {
    print("Illegal destination name\n");
    exit(1);
}

const node = configuration.getName() || "?";
const destMetric = atr.lookupDestPathMetric(dest);
const metricPart = destMetric != null ? `${destMetric}` : "-";
print(`Aredn-Traceroute(${atr.packageVersion()}): ${atr.shortMeshName(node)} to ${atr.shortMeshName(dest)}  Babel Metric ${metricPart}\n`);

const ok = atr.runEnrichedTraceroute(dest, function (line) {
    print(`${line}\n`);
}, { verbose: verbose, gps: gps });
exit(ok ? 0 : 1);
