#!/bin/sh
# Isolated ath10k spectral FFT capture with hard timeout + recovery.
# Only one spectral op at a time (flock). Never leaves spectral enabled.
#
# Note: many AREDN images lack timeout(1) and usleep(1), and busybox sleep
# is integer seconds only — use /proc/uptime busy-waits for sub-second delays.
#
# Usage: waterfall-ath10k-fft -i iface -p phy [-o outfile] [-t hard_timeout_sec] [-d stream_secs] [--scan]
# Exit: 0=bytes, 1=empty, 2=lock busy, 3=cooldown, 4=timeout/recovered, 5=error
set -u

IFACE=""
PHY=""
OUT="/tmp/waterfall-fft.bin"
HARD=""
DUR=0
ALLOW_SCAN=0
SAFE_RECOVER=1

while [ $# -gt 0 ]; do
  case "$1" in
    -i) IFACE="$2"; shift 2 ;;
    -p) PHY="$2"; shift 2 ;;
    -o) OUT="$2"; shift 2 ;;
    -t) HARD="$2"; shift 2 ;;
    -d) DUR="$2"; shift 2 ;;
    --scan) ALLOW_SCAN=1; shift ;;
    --safe-recover) SAFE_RECOVER=1; shift ;;
    --escalate-recover) SAFE_RECOVER=0; shift ;;
    *) shift ;;
  esac
done

[ -n "$IFACE" ] && [ -n "$PHY" ] || {
  echo "usage: waterfall-ath10k-fft -i iface -p phy [-o file] [-t secs] [-d stream_secs] [--scan] [--safe-recover]" >&2
  exit 5
}

if [ -z "$HARD" ]; then
  if [ "$DUR" -gt 0 ] 2>/dev/null; then
    HARD=$((DUR + 8))
  else
    HARD=4
  fi
fi

DBG="/sys/kernel/debug/ieee80211/$PHY/ath10k"
CTL="$DBG/spectral_scan_ctl"
CNT="$DBG/spectral_count"
BINS="$DBG/spectral_bins"
REL="$DBG/spectral_scan0"
LOCK="/tmp/waterfall-spectral.lock"
COOL="/tmp/waterfall-spectral.cooldown"
FAILS="/tmp/waterfall-spectral.fails"
WD_PID=""
SELF=$$

ts() { date +%s 2>/dev/null || echo 0; }

uptime_cs() {
  awk '{printf "%d", $1 * 100}' /proc/uptime
}

# Wait N centiseconds without sleep/usleep/timeout.
# Prefer a calibrated busy-loop (awk-in-a-spin is too slow on MIPS).
wait_cs() {
  _n="$1"
  # ~100 loops ≈ 1 cs on QCA MIPS 24kc (tuned on hAP ac lite)
  _i=$((_n * 100))
  while [ "$_i" -gt 0 ]; do
    _i=$((_i - 1))
  done
}

disable_ctl() {
  echo disable > "$CTL" 2>/dev/null || true
}

cleanup() {
  disable_ctl
  if [ -n "$WD_PID" ] && kill -0 "$WD_PID" 2>/dev/null; then
    kill "$WD_PID" 2>/dev/null || true
    wait "$WD_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM HUP

# Cooldown after prior failure/recovery
if [ -f "$COOL" ]; then
  until=$(cat "$COOL" 2>/dev/null || echo 0)
  now=$(ts)
  if [ "$until" -gt "$now" ] 2>/dev/null; then
    echo "cooldown $((until - now))s remaining" >&2
    exit 3
  fi
fi

[ -e "$CTL" ] && [ -e "$REL" ] || {
  echo "missing spectral debugfs under $DBG" >&2
  exit 5
}

# Arm watchdog BEFORE taking the spectral lock so it never inherits flock fd 9.
(
  sleep "$HARD"
  echo "waterfall-ath10k-fft watchdog fire after ${HARD}s" >&2
  disable_ctl
  kill "$SELF" 2>/dev/null || true
  /usr/bin/waterfall-spectral-recover "$IFACE" "$PHY" $([ "$SAFE_RECOVER" -eq 1 ] && echo --safe || echo --escalate) >/dev/null 2>&1 || true
  exit 0
) &
WD_PID=$!

# Serialize all spectral ops (busybox flock if present; else mkdir lock)
have_flock=0
command -v flock >/dev/null 2>&1 && have_flock=1
if [ "$have_flock" -eq 1 ]; then
  exec 9>"$LOCK"
  if ! flock -n 9; then
    echo "spectral lock busy" >&2
    exit 2
  fi
else
  if ! mkdir "$LOCK.d" 2>/dev/null; then
    echo "spectral lock busy" >&2
    exit 2
  fi
  trap 'cleanup; rmdir "$LOCK.d" 2>/dev/null || true' EXIT INT TERM HUP
fi

# Bounded relay read: dd can block on empty debugfs; kill after N cs.
quick_dd() {
  _if="$1"
  _of="$2"
  _cnt="$3"
  _cs="$4"
  dd if="$_if" of="$_of" bs=4096 count="$_cnt" 2>/dev/null &
  _ddp=$!
  wait_cs "$_cs"
  kill "$_ddp" 2>/dev/null || true
  wait "$_ddp" 2>/dev/null || true
}

: > "$OUT"
quick_dd "$REL" /dev/null 2 5
echo 64 > "$CNT" 2>/dev/null || true
echo 64 > "$BINS" 2>/dev/null || true

if [ "$DUR" -gt 0 ] 2>/dev/null; then
  # Experimental multi-second stream. Prefer DUR<=1 on IBSS — longer windows
  # have wedged QCA9887 mesh. Do NOT run iw scan.
  echo background > "$CTL" || {
    echo "cannot write background to ctl" >&2
    exit 5
  }
  echo trigger > "$CTL" || true
  end=$(($(ts) + DUR))
  while [ "$(ts)" -lt "$end" ]; do
    quick_dd "$REL" /tmp/waterfall-fft.chunk 4 20
    cat /tmp/waterfall-fft.chunk >> "$OUT" 2>/dev/null || true
    rm -f /tmp/waterfall-fft.chunk
    wait_cs 5
  done
  disable_ctl
else
  # Short background pulse (~50–80ms settle + ~150ms read). No iw scan.
  echo background > "$CTL" || {
    echo "cannot write background to ctl" >&2
    exit 5
  }
  echo trigger > "$CTL" || true
  wait_cs 6
  quick_dd "$REL" "$OUT" 8 15
  disable_ctl

  if [ "$(wc -c < "$OUT" 2>/dev/null || echo 0)" -eq 0 ]; then
    quick_dd "$REL" /dev/null 2 5
    echo background > "$CTL" || true
    echo trigger > "$CTL" || true
    wait_cs 10
    : > "$OUT"
    quick_dd "$REL" "$OUT" 8 20
    disable_ctl
  fi

  if [ "$(wc -c < "$OUT" 2>/dev/null || echo 0)" -eq 0 ] && [ "$ALLOW_SCAN" -eq 1 ]; then
    quick_dd "$REL" /dev/null 2 5
    echo background > "$CTL" || true
    echo trigger > "$CTL" || true
    # scan path is last-resort only; may disrupt mesh
    iw dev "$IFACE" scan >/dev/null 2>&1 || true
    disable_ctl
    quick_dd "$REL" "$OUT" 8 20
  fi
fi

BYTES=$(wc -c < "$OUT" 2>/dev/null || echo 0)

if [ -n "$WD_PID" ]; then
  kill "$WD_PID" 2>/dev/null || true
  wait "$WD_PID" 2>/dev/null || true
  WD_PID=""
fi
disable_ctl

if [ "${BYTES:-0}" -gt 0 ]; then
  rm -f "$FAILS" "$COOL" 2>/dev/null || true
  echo "ok bytes=$BYTES" >&2
  exit 0
fi

echo "empty relay" >&2
exit 1
