#!/bin/sh
# Clear runtime session/badge state when the package is upgraded.
ps w 2>/dev/null | grep aredn-terminal-session | grep -v grep | while read pid rest; do
	kill -9 "$pid" 2>/dev/null
done
ps w 2>/dev/null | grep '/bin/ash -l' | grep -v grep | while read pid rest; do
	kill -9 "$pid" 2>/dev/null
done
ps w 2>/dev/null | grep 'tail -f /tmp/aredn-terminal' | grep -v grep | while read pid rest; do
	kill -9 "$pid" 2>/dev/null
done
rm -rf /tmp/aredn-terminal
rm -f /tmp/apps/terminal/badge /tmp/apps/terminal/badge-color
exit 0
