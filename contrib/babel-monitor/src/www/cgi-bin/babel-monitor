#!/usr/bin/ucode
/**
 * babel-monitor CGI — public JSON pull API (meta/hello/sync/events/live/series/logs/syslog/top)
 * plus streaming text download (api=download). Optional gzip L1 via ucode-mod-zlib.
 * Does not touch Prometheus.
 */
import * as fs from "fs";
import * as socket from "socket";
import * as zlib from "zlib";
import * as client from "babel_monitor.client";
import * as configlib from "babel_monitor.config";

const q = getenv("QUERY_STRING") || "";
const cfg = configlib.loadConfig();
const BABEL_SOCK = { path: "/var/run/babel.sock" };

function qparam(name)
{
    const m = match(q, regexp(name + "=([^&]*)"));
    return m ? m[1] : null;
}

function parseCompress(raw, dflt)
{
    if (raw == null || raw === "") {
        return dflt;
    }
    const s = lc(raw);
    if (s === "1" || s === "on" || s === "true" || s === "yes") {
        return true;
    }
    if (s === "0" || s === "off" || s === "false" || s === "no") {
        return false;
    }
    return dflt;
}

/** Stream raw log sources as attachment — no JSON, no filters, no tail limit. */
function downloadHeaders(filename)
{
    print("Status: 200 OK\r\n");
    print("Content-Type: text/plain; charset=utf-8\r\n");
    print(sprintf("Content-Disposition: attachment; filename=\"%s\"\r\n", filename));
    print("Cache-Control: no-store\r\n");
    print("Access-Control-Allow-Origin: *\r\n\r\n");
}

function streamPopen(cmd)
{
    const p = fs.popen(cmd);
    if (!p) {
        print("(unavailable)\n");
        return;
    }
    for (let chunk = p.read(8192); length(chunk); chunk = p.read(8192)) {
        print(chunk);
    }
    p.close();
}

function streamFile(path)
{
    const f = fs.open(path, "r");
    if (!f) {
        print(sprintf("(no %s)\n", path));
        return;
    }
    for (let chunk = f.read(8192); length(chunk); chunk = f.read(8192)) {
        print(chunk);
    }
    f.close();
}

function streamBabelDump(cmd)
{
    const c = socket.connect(BABEL_SOCK);
    if (!c) {
        print("(unavailable)\n");
        return;
    }
    c.send(`${cmd}\nquit\n`);
    for (let n = 0; n < 512; n++) {
        const v = c.recv(8192);
        if (!v || v === "") {
            break;
        }
        print(v);
        /* Soft cap so a stuck babel.sock cannot hang CGI forever */
        if (n >= 511) {
            print("\n… truncated\n");
        }
    }
    c.close();
}

function handleDownload(source)
{
    const src = lc(source || "syslog");
    if (src === "syslog") {
        downloadHeaders("babel-monitor-syslog.txt");
        /* Full logread ring — no -l, no filters */
        streamPopen("logread 2>/dev/null");
        exit(0);
    }
    if (src === "lqm") {
        downloadHeaders("babel-monitor-lqm.info");
        streamFile("/tmp/lqm.info");
        exit(0);
    }
    if (src === "dmesg") {
        downloadHeaders("babel-monitor-dmesg.txt");
        streamPopen("dmesg 2>/dev/null");
        exit(0);
    }
    if (src === "dumps") {
        downloadHeaders("babel-monitor-dumps.txt");
        print("=== dump-neighbors ===\n");
        streamBabelDump("dump-neighbors");
        print("\n=== dump-routable-neighbors ===\n");
        streamBabelDump("dump-routable-neighbors");
        print("\n=== dump-installed-routes ===\n");
        streamBabelDump("dump-installed-routes");
        exit(0);
    }
    print("Status: 400 Bad Request\r\n");
    print("Content-Type: application/json\r\n");
    print("Cache-Control: no-store\r\n");
    print("Access-Control-Allow-Origin: *\r\n\r\n");
    print(sprintf('{"error":"unknown download source","source":"%s"}\n', src));
    exit(0);
}

let api = qparam("api") || "meta";
api = lc(api);
if (api === "hello") {
    api = "meta";
}

if (api === "download") {
    handleDownload(qparam("source") || "syslog");
}

let cmd = null;
if (api === "meta") {
    cmd = "meta";
}
else if (api === "live") {
    cmd = "live";
}
else if (api === "sync") {
    const since = qparam("since_seq") || "0";
    const limit = qparam("limit") || "";
    cmd = sprintf("sync since_seq=%s", since);
    if (limit !== "") {
        cmd += sprintf(" limit=%s", limit);
    }
}
else if (api === "events") {
    const since = qparam("since_seq") || "0";
    const limit = qparam("limit") || "";
    cmd = sprintf("events since_seq=%s", since);
    if (limit !== "") {
        cmd += sprintf(" limit=%s", limit);
    }
}
else if (api === "series") {
    const sec = qparam("seconds") || "300";
    const end_age = qparam("end_age") || "0";
    cmd = sprintf("series seconds=%s end_age=%s", sec, end_age);
}
else if (api === "syslog") {
    const limit = qparam("limit") || "50";
    const filters = qparam("filters") || "all";
    cmd = sprintf("syslog limit=%s filters=%s", limit, filters);
}
else if (api === "logs") {
    const source = qparam("source") || "syslog";
    const limit = qparam("limit") || "50";
    const filters = qparam("filters") || "all";
    cmd = sprintf("logs source=%s limit=%s filters=%s", source, limit, filters);
}
else if (api === "top") {
    cmd = "top";
}
else {
    print("Status: 400 Bad Request\r\n");
    print("Content-Type: application/json\r\n");
    print("Cache-Control: no-store\r\n");
    print("Access-Control-Allow-Origin: *\r\n\r\n");
    print(sprintf('{"error":"unknown api","api":"%s"}\n', api));
    exit(0);
}

const resp = client.query(cmd);
if (!resp) {
    print("Status: 503 Service Unavailable\r\n");
    print("Content-Type: application/json\r\n");
    print("Cache-Control: no-store\r\n");
    print("Access-Control-Allow-Origin: *\r\n\r\n");
    print('{"error":"babel-monitord unavailable"}\n');
    exit(0);
}

let body = sprintf("%.J", resp);
const want = parseCompress(qparam("compress"), cfg.compress);
const accept = getenv("HTTP_ACCEPT_ENCODING") || "";
const client_gzip = index(accept, "gzip") >= 0;
let use_gzip = want && client_gzip && length(body) >= cfg.compress_min_bytes;

print("Status: 200 OK\r\n");
print("Content-Type: application/json\r\n");
print("Cache-Control: no-store\r\n");
print("Access-Control-Allow-Origin: *\r\n");

if (use_gzip) {
    try {
        body = zlib.deflate(body, true, 1);
        print("Content-Encoding: gzip\r\n");
    }
    catch (e) {
        use_gzip = false;
    }
}

print(sprintf("Content-Length: %d\r\n", length(body)));
print("\r\n");
print(body);
