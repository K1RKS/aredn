#!/bin/sh
# Keep a login ash session alive with FIFO stdin and file-captured stdout.
# Usage: aredn-terminal-session <session-dir>
set -e
DIR="$1"
[ -n "$DIR" ] || exit 1
[ -d "$DIR" ] || exit 1

mkfifo "$DIR/stdin" 2>/dev/null || true
: > "$DIR/stdout"
date +%s > "$DIR/heartbeat"

# Open FIFO read/write so ash does not block on open; keep fd open in this process.
exec 3<>"$DIR/stdin"
/bin/ash -l <&3 >>"$DIR/stdout" 2>&1 &
echo $! > "$DIR/pid"

# Stay alive while the shell lives so fd 3 remains open for writers.
while kill -0 "$(cat "$DIR/pid")" 2>/dev/null; do
	sleep 1
done
exit 0
