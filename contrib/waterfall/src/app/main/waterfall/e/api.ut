{%
/*
 * Secured JSON API: /a/waterfall/e/api?action=start|stop|status|cache
 * Admin required by AREDN /e/ routing.
 * Query: iface=wlan0  duration=30
 */
import * as wf from "waterfall";
response.headers["Content-Type"] = "application/json";

if (!auth.isAdmin) {
    response.statusCode = 401;
    print(sprintf("%J", { ok: false, error: "Admin authentication required" }));
    return;
}

const q = request.env.QUERY_STRING || "";
const mAction = match(q, /action=([a-zA-Z0-9_-]+)/);
const mIface = match(q, /iface=([a-zA-Z0-9]+)/);
const mDur = match(q, /duration=([0-9]+)/);
const mCh = match(q, /channel=([a-zA-Z0-9_-]+)/);
const mBw = match(q, /bandwidth=([a-zA-Z0-9_-]+)/);
const mFft = match(q, /allow_fft=([01])/);
const mAmp = match(q, /amplify_survey=([01])/);
const action = (request.args && request.args.action) || (mAction ? mAction[1] : "status");
const iface = (request.args && request.args.iface) || (mIface ? mIface[1] : null);
const duration = (request.args && request.args.duration) ? int(request.args.duration) : (mDur ? int(mDur[1]) : 30);
const channel = (request.args && request.args.channel) || (mCh ? mCh[1] : null);
const bandwidth = (request.args && request.args.bandwidth) || (mBw ? mBw[1] : null);
const allowFft = (request.args && (request.args.allow_fft === "1" || request.args.allow_fft === 1)) ||
    (mFft && mFft[1] === "1");
/* Survey amplify defaults on; amplify_survey=0 disables. */
let amplifySurvey = true;
if (request.args && (request.args.amplify_survey === "0" || request.args.amplify_survey === 0)) {
    amplifySurvey = false;
}
else if (mAmp && mAmp[1] === "0") {
    amplifySurvey = false;
}
else if (request.args && (request.args.amplify_survey === "1" || request.args.amplify_survey === 1)) {
    amplifySurvey = true;
}
else if (mAmp && mAmp[1] === "1") {
    amplifySurvey = true;
}

if (action === "start") {
    print(sprintf("%J", wf.startSessionAsync(iface, duration, channel, bandwidth, allowFft, amplifySurvey)));
}
else if (action === "stop") {
    print(sprintf("%J", wf.stopSession()));
}
else if (action === "clear_cache") {
    print(sprintf("%J", wf.clearAllCaches()));
}
else if (action === "cache") {
    print(sprintf("%J", wf.readCache(iface)));
}
else if (action === "status" || action === "session_status" || action === "probe") {
    print(sprintf("%J", wf.sessionStatus(iface)));
}
else {
    response.statusCode = 400;
    print(sprintf("%J", { ok: false, error: "Unknown action", version: wf.packageVersion() }));
}
%}
