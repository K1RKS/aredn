#!/usr/bin/ucode
/**
 * babel-monitord — in-RAM metrics collector + control/data socket.
 * No metric flash I/O. Does not touch Prometheus.
 */
import * as fs from "fs";
import * as uloop from "uloop";
import * as socket from "socket";
import * as common from "babel_monitor.common";
import * as storelib from "babel_monitor.store";
import * as samplelib from "babel_monitor.sample";
import * as configlib from "babel_monitor.config";

fs.mkdir(common.RUN_DIR);
const store = storelib.createStore();
store.boot_id = common.bootIdNew();
let cfg = configlib.loadConfig();
samplelib.refreshIdentity(store);

let sample_timer = null;
let peak_timer = null;

function readDaemonRssKb()
{
    const raw = fs.readfile("/proc/self/status");
    if (!raw) {
        return null;
    }
    const m = match(raw, /VmRSS:\s+([0-9]+)/);
    if (!m) {
        return null;
    }
    return int(m[1]);
}

/** Last N syslog lines via logread (not stored in the sample ring). */
function readSyslogLines(limit, filters)
{
    /* Pull extra when filtering so the returned set still has useful depth */
    const want = common.clampInt(limit, 1, 200, 50);
    const pull = length(filters) ? common.clampInt(want * 4, want, 400, want * 4) : want;
    const raw = [];
    const p = fs.popen(sprintf("logread -l %d 2>/dev/null", pull));
    if (!p) {
        return raw;
    }
    for (let line = p.read("line"); length(line); line = p.read("line")) {
        push(raw, trim(line));
    }
    p.close();

    if (!length(filters)) {
        /* newest last — keep last want lines */
        if (length(raw) <= want) {
            return raw;
        }
        const out = [];
        for (let i = length(raw) - want; i < length(raw); i++) {
            push(out, raw[i]);
        }
        return out;
    }

    const out = [];
    for (let i = 0; i < length(raw); i++) {
        const line = raw[i];
        const low = lc(line);
        let hit = false;
        for (let fi = 0; fi < length(filters); fi++) {
            const f = filters[fi];
            if (f === "babel" && index(low, "babel") >= 0) {
                hit = true;
            }
            else if (f === "lqm" && index(low, "lqm") >= 0) {
                hit = true;
            }
            else if (f === "arednlink" && index(low, "arednlink") >= 0) {
                hit = true;
            }
            else if (f === "dnsmasq" && index(low, "dnsmasq") >= 0) {
                hit = true;
            }
            else if (f === "netifd" && index(low, "netifd") >= 0) {
                hit = true;
            }
            else if (f === "auth" && (index(low, "dropbear") >= 0 ||
                index(low, "authpriv") >= 0 || index(low, "auth.") >= 0)) {
                hit = true;
            }
            if (hit) {
                break;
            }
        }
        if (hit) {
            push(out, line);
        }
    }
    if (length(out) <= want) {
        return out;
    }
    const trimmed = [];
    for (let i = length(out) - want; i < length(out); i++) {
        push(trimmed, out[i]);
    }
    return trimmed;
}

function parseFilterList(raw)
{
    const filters = [];
    if (raw == null || raw === "" || lc(raw) === "all") {
        return filters;
    }
    const parts = split(raw, ",");
    for (let i = 0; i < length(parts); i++) {
        const f = lc(trim(parts[i]));
        if (f === "babel" || f === "lqm" || f === "arednlink" ||
            f === "dnsmasq" || f === "netifd" || f === "auth") {
            push(filters, f);
        }
    }
    return filters;
}

function readDmesgLines(limit)
{
    const want = common.clampInt(limit, 1, 200, 80);
    const raw = [];
    const p = fs.popen("dmesg 2>/dev/null");
    if (!p) {
        return raw;
    }
    for (let line = p.read("line"); length(line); line = p.read("line")) {
        push(raw, replace(`${line}`, /\r?\n$/, ""));
    }
    p.close();
    if (length(raw) <= want) {
        return raw;
    }
    const out = [];
    for (let i = length(raw) - want; i < length(raw); i++) {
        push(out, raw[i]);
    }
    return out;
}

function readLqmInfoLines()
{
    const lines = [];
    const raw = fs.readfile("/tmp/lqm.info");
    if (!raw || raw === "") {
        push(lines, "(no /tmp/lqm.info)");
        return lines;
    }
    /* Prefer pretty JSON when valid */
    try {
        const obj = json(raw);
        push(lines, sprintf("%.J", obj));
        return lines;
    }
    catch (e) {
    }
    return split(replace(`${raw}`, /\r$/, ""), "\n");
}

function appendDumpSection(out, title, dump_lines, max_lines)
{
    push(out, "=== " + title + " ===");
    if (!dump_lines) {
        push(out, "(unavailable)");
        push(out, "");
        return;
    }
    let n = 0;
    for (let i = 0; i < length(dump_lines); i++) {
        const line = dump_lines[i];
        if (line === "") {
            continue;
        }
        if (max_lines && n >= max_lines) {
            push(out, sprintf("… truncated after %d lines", max_lines));
            break;
        }
        push(out, line);
        n++;
    }
    push(out, "");
}

function readBabelDumpLines()
{
    const out = [];
    appendDumpSection(out, "dump-neighbors", samplelib.babelDumpCmd("dump-neighbors"), 200);
    appendDumpSection(out, "dump-routable-neighbors",
        samplelib.babelDumpCmd("dump-routable-neighbors"), 200);
    appendDumpSection(out, "dump-installed-routes",
        samplelib.babelDumpCmd("dump-installed-routes"), 150);
    return out;
}

/** One-shot process table via busybox top -bn1 (not stored in the ring). */
function readTopLines()
{
    const lines = [];
    const p = fs.popen("top -bn1 2>/dev/null");
    if (!p) {
        return lines;
    }
    for (let line = p.read("line"); length(line); line = p.read("line")) {
        /* Keep leading spaces so columns stay aligned */
        push(lines, replace(`${line}`, /\r?\n$/, ""));
    }
    p.close();
    return lines;
}

function metaObj()
{
    const oldest = storelib.peekOldest(store);
    const newest = storelib.peekNewest(store);
    return {
        api_version: common.API_VERSION,
        schema_version: common.SCHEMA_VERSION,
        package_version: common.packageVersion(),
        node_id: store.identity.node_id,
        mac: store.identity.mac,
        hostname: store.identity.hostname,
        boot_id: store.boot_id,
        sample_interval: cfg.sample_interval,
        retention_s: cfg.sample_interval * store.sample_cap,
        sample_count: store.sample_count,
        sample_cap: store.sample_cap,
        oldest_t: oldest ? oldest.t : null,
        oldest_seq: oldest ? oldest.seq : 0,
        newest_t: newest ? newest.t : null,
        newest_seq: newest ? newest.seq : 0,
        label_count: length(store.labels),
        mem_total_kb: store.last.mem_total_kb,
        compress_default: cfg.compress ? "on" : "off",
        enabled: cfg.enabled ? "on" : "off",
        sync_limit: cfg.sync_limit,
        compress_min_bytes: cfg.compress_min_bytes,
        rss_estimate_bytes: storelib.estimateBytes(store),
        daemon_rss_kb: readDaemonRssKb()
    };
}

function handleRequest(line)
{
    line = trim(line);
    if (!length(line)) {
        return { error: "empty" };
    }

    const parts = split(line, " ");
    const cmd = lc(parts[0]);
    const args = {};
    for (let i = 1; i < length(parts); i++) {
        const kv = split(parts[i], "=", 2);
        if (length(kv) === 2) {
            args[kv[0]] = kv[1];
        }
    }

    if (cmd === "meta" || cmd === "hello") {
        samplelib.refreshIdentity(store);
        return metaObj();
    }
    if (cmd === "live") {
        return {
            boot_id: store.boot_id,
            node_id: store.identity.node_id,
            neighbors: store.live_neighbors,
            latest: storelib.latestSample(store),
            wg: store.wg,
            meta: metaObj()
        };
    }
    if (cmd === "sync") {
        const since = int(args.since_seq || 0);
        const limit = common.clampInt(args.limit || cfg.sync_limit, 1, 2000, cfg.sync_limit);
        const r = storelib.syncSamples(store, since, limit);
        let next_seq = since;
        if (length(r.samples)) {
            next_seq = r.samples[length(r.samples) - 1].seq;
        }
        const hit_end = !length(r.samples) || next_seq >= r.newest_seq;
        return {
            boot_id: store.boot_id,
            node_id: store.identity.node_id,
            truncated: r.truncated,
            gap_before: r.gap_before,
            next_seq: next_seq,
            next_t: length(r.samples) ? r.samples[length(r.samples) - 1].t : null,
            complete: hit_end || length(r.samples) < limit,
            samples: r.samples
        };
    }
    if (cmd === "events") {
        const since = int(args.since_seq || 0);
        const limit = common.clampInt(args.limit || cfg.sync_limit, 1, 2000, cfg.sync_limit);
        const r = storelib.syncEvents(store, since, limit);
        return {
            boot_id: store.boot_id,
            truncated: r.truncated,
            events: r.events,
            next_seq: length(r.events) ? r.events[length(r.events) - 1].seq : since,
            complete: true
        };
    }
    if (cmd === "series") {
        const sec = common.clampInt(args.seconds || common.SERIES_SLICE_S, 1, common.SERIES_SLICE_S, common.SERIES_SLICE_S);
        const end_age = common.clampInt(args.end_age || 0, 0, 14400, 0);
        return {
            boot_id: store.boot_id,
            seconds: sec,
            end_age: end_age,
            samples: storelib.seriesWindow(store, sec, end_age)
        };
    }
    if (cmd === "syslog") {
        const limit = common.clampInt(args.limit || 50, 1, 200, 50);
        const filters = parseFilterList(args.filters);
        return {
            boot_id: store.boot_id,
            source: "syslog",
            limit: limit,
            filters: filters,
            lines: readSyslogLines(limit, filters)
        };
    }
    if (cmd === "logs") {
        const source = lc(args.source || "syslog");
        const limit = common.clampInt(args.limit || 50, 1, 200, 50);
        if (source === "syslog") {
            const filters = parseFilterList(args.filters);
            return {
                boot_id: store.boot_id,
                source: "syslog",
                limit: limit,
                filters: filters,
                lines: readSyslogLines(limit, filters)
            };
        }
        if (source === "dumps") {
            return {
                boot_id: store.boot_id,
                source: "dumps",
                lines: readBabelDumpLines()
            };
        }
        if (source === "lqm") {
            return {
                boot_id: store.boot_id,
                source: "lqm",
                lines: readLqmInfoLines()
            };
        }
        if (source === "dmesg") {
            return {
                boot_id: store.boot_id,
                source: "dmesg",
                limit: limit,
                lines: readDmesgLines(limit)
            };
        }
        return { error: "unknown logs source", source: source };
    }
    if (cmd === "top") {
        return {
            boot_id: store.boot_id,
            lines: readTopLines()
        };
    }
    if (cmd === "get") {
        return {
            settings: {
                enabled: cfg.enabled ? "on" : "off",
                sample_interval: cfg.sample_interval,
                compress: cfg.compress ? "on" : "off",
                sync_limit: cfg.sync_limit,
                compress_min_bytes: cfg.compress_min_bytes
            },
            status: metaObj()
        };
    }
    if (cmd === "set") {
        let changed = false;
        const prev_interval = cfg.sample_interval;
        for (let k in args) {
            if (configlib.applySetting(cfg, k, args[k])) {
                changed = true;
            }
        }
        if (!changed) {
            return { ok: false, error: "no valid settings" };
        }
        configlib.saveConfig(cfg);
        if (sample_timer && cfg.sample_interval !== prev_interval) {
            sample_timer.set(cfg.sample_interval * 1000);
        }
        return {
            ok: true,
            settings: {
                enabled: cfg.enabled ? "on" : "off",
                sample_interval: cfg.sample_interval,
                compress: cfg.compress ? "on" : "off",
                sync_limit: cfg.sync_limit,
                compress_min_bytes: cfg.compress_min_bytes
            }
        };
    }
    return { error: sprintf("unknown cmd: %s", cmd) };
}

function serveClient(client)
{
    let buf = "";
    uloop.handle(client, (events) => {
        if (!(events & uloop.ULOOP_READ)) {
            return;
        }
        const data = client.recv(8192);
        if (!data || length(data) === 0) {
            client.close();
            return;
        }
        buf += data;
        while (true) {
            const n = index(buf, "\n");
            if (n < 0) {
                break;
            }
            const line = substr(buf, 0, n);
            buf = substr(buf, n + 1);
            if (trim(line) === "quit") {
                client.close();
                return;
            }
            const resp = handleRequest(line);
            client.send(sprintf("%J\n", resp));
            /* Series/sync expand many temps — reclaim after reply */
            gc();
        }
    }, uloop.ULOOP_READ);
}

function doSample()
{
    samplelib.collectSample(store, cfg);
    /* Sample path allocates boxed ints + babel/LQM temps each tick */
    gc();
    if (sample_timer) {
        sample_timer.set(cfg.sample_interval * 1000);
    }
    else {
        sample_timer = uloop.timer(cfg.sample_interval * 1000, doSample);
    }
}

function doCpuPeak()
{
    samplelib.updateCpuPeak(store);
    if (peak_timer) {
        peak_timer.set(1000);
    }
}

function main()
{
    fs.unlink(common.SOCK_PATH);
    const listener = socket.create(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_NONBLOCK, 0);
    if (!listener) {
        print("babel-monitord: socket.create failed: ", socket.error(), "\n");
        return 1;
    }
    if (!listener.bind({ family: socket.AF_UNIX, path: common.SOCK_PATH })) {
        print("babel-monitord: bind failed: ", socket.error(), "\n");
        return 1;
    }
    if (!listener.listen(16)) {
        print("babel-monitord: listen failed: ", socket.error(), "\n");
        return 1;
    }
    try {
        fs.chmod(common.SOCK_PATH, 0600);
    }
    catch (e) {
    }

    uloop.init();

    /* Secondary mark-and-sweep GC (refcount alone cannot reclaim cycles/temps).
     * Interval = object allocations between automatic sweeps. */
    gc("start", 500);

    uloop.handle(listener, (events) => {
        if (!(events & uloop.ULOOP_READ)) {
            return;
        }
        const client = listener.accept();
        if (client) {
            serveClient(client);
        }
    }, uloop.ULOOP_READ);

    print(sprintf("babel-monitord %s boot_id=%s interval=%d\n",
        common.packageVersion(), store.boot_id, cfg.sample_interval));

    /* First sample after uloop is running so the control socket stays responsive */
    sample_timer = uloop.timer(0, doSample);
    peak_timer = uloop.timer(1000, doCpuPeak);

    uloop.run();
    return 0;
}

exit(main());
