#!/usr/bin/ucode
/*
 * StableRoute CGI — run /usr/bin/stableroute and stream the report.
 * Query: server=<dest>&n=<runs>&legacy=1&debug=1
 *
 * uhttpd network_timeout is ~30s idle. A background keepalive beats that while
 * a single traceroute is silent between hops (LQM stalls, long paths, etc.).
 */

import * as fs from "fs";

const q = getenv("QUERY_STRING") || "";

const mServer = match(q, /server=([^&]*)/);
let server = mServer && mServer[1];
const mN = match(q, /n=([0-9]+)/);
let n = mN ? int(mN[1]) : 10;
const legacy = match(q, /legacy=1/) ? true : false;
const debug = match(q, /debug=1/) ? true : false;

print("Content-type: text/html\r\n");
print("Cache-Control: no-store\r\n");
print("Access-Control-Allow-Origin: *\r\n");
print("\r\n");

if (!server) {
    print("<html><head><title>ERROR</title></head><body><pre>Provide a target [/cgi-bin/stableroute?server=&lt;Target&gt;]</pre></body></html>\n");
}
else if (match(server, /[^0-9a-zA-Z.\-]/)) {
    print("<html><head><title>ERROR</title></head><body><pre>Illegal target name</pre></body></html>\n");
}
else if (n < 1 || n > 100) {
    print("<html><head><title>ERROR</title></head><body><pre>n must be between 1 and 100</pre></body></html>\n");
}
else if (!fs.access("/usr/bin/stableroute")) {
    print("<html><head><title>ERROR</title></head><body><pre>stableroute is not installed on this node</pre></body></html>\n");
}
else {
    if (!match(server, /\./) && !match(server, /^[0-9.]+$/)) {
        server += ".local.mesh";
    }
    let args = `-progress -n ${n}`;
    if (legacy) {
        args += " -legacy";
    }
    if (debug) {
        args += " -debug";
    }
    // Keepalive every 10s while stableroute may be blocked inside one probe.
    const cmd = `sh -c 'while sleep 10; do echo __sr_ka__; done & KP=$!; /usr/bin/stableroute ${args} ${server}; EC=$?; kill $KP 2>/dev/null; wait $KP 2>/dev/null; exit $EC'`;
    const running = fs.popen(`${cmd} 2>&1`);
    if (!running) {
        print("<html><head><title>ERROR</title></head><body><pre>stableroute failed to start</pre></body></html>\n");
    }
    else {
        print("<html><head><title>SUCCESS</title></head>\n");
        // Header (Source/Target/Runs) is rendered by the Tools UI, like traceroute.
        print("<body><pre>");
        flush();
        // Line reads: non-TTY stableroute emits newline progress keepalives.
        for (let line = running.read("line"); length(line); line = running.read("line")) {
            print(line);
            flush();
        }
        running.close();
        print("</pre></body></html>\n");
    }
}
