#!/bin/sh
# Re-apply Tools → StableRoute menu entry after upgrade.
. /usr/share/stableroute/tools-menu.sh 2>/dev/null || exit 0
install_tools_menu
chmod 755 /www/cgi-bin/stableroute 2>/dev/null || true
chmod 644 /app/main/tools/e/stableroute.ut 2>/dev/null || true
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart 2>/dev/null || true
exit 0
