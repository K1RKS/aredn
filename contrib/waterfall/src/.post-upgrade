#!/bin/sh
# Re-apply Tools → Waterfall menu entry after upgrade.
. /usr/share/waterfall/tools-menu.sh 2>/dev/null || exit 0
install_tools_menu
chmod 755 /www/cgi-bin/waterfall 2>/dev/null || true
chmod 755 /usr/bin/waterfall 2>/dev/null || true
chmod 755 /usr/bin/waterfall-session 2>/dev/null || true
chmod 755 /usr/bin/waterfall-ath10k-fft 2>/dev/null || true
chmod 755 /usr/bin/waterfall-spectral-recover 2>/dev/null || true
chmod 644 /app/main/tools/e/waterfall.ut 2>/dev/null || true
chmod 644 /app/main/waterfall.ut 2>/dev/null || true
chmod 644 /app/main/waterfall/e/api.ut 2>/dev/null || true
chmod 644 /www/waterfall/waterfall-ui.js 2>/dev/null || true
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart 2>/dev/null || true
exit 0
