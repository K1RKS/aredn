{%
/*
 * Waterfall Tools dialog — admin RF spectral heatmap (bounded session).
 */
%}
{%
import * as wf from "waterfall";
const cap = wf.probeCapability();
const supported = !!cap.supported;
const unsupportedMsg = cap.unsupported_message || "Waterfall is not supported on this hardware.";
%}
<div class="dialog wide">
    {{_R("tool-header", { label: `Waterfall ${wf.packageVersion()}`, help: false })}}
    <div class="waterfall-tool" style="padding:8px 12px 12px">
        {% if (!supported) { %}
        <div class="error" style="margin:0 0 12px;padding:10px 12px;border:1px solid #a44;background:#2a1515;color:#f0c0c0;border-radius:4px">
            <div style="font-weight:600;margin-bottom:4px">Hardware not supported</div>
            <div>{{unsupportedMsg}}</div>
        </div>
        {% } else { %}
        <div style="margin:0 0 8px;font-size:0.9em;opacity:0.9">
            ath9k uses spectral FFT (disrupts RF). On QCA988x (hAP ac lite 5&nbsp;GHz) the default is
            <b>survey</b> (safe). Experimental FFT is opt-in only (short, disable-only recover — no wifi reload).
        </div>
        {% } %}
        <div class="wf-radio-row" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 8px">
            <label style="font-size:0.9em">Radio</label>
            <select class="wf-radio" style="min-width:12rem;max-width:100%;flex:1"></select>
            <label style="font-size:0.9em">Section</label>
            <select class="wf-duration" style="min-width:6rem" title="Listen time per frequency section"></select>
            <label style="font-size:0.9em">Channel</label>
            <select class="wf-channel" style="min-width:8rem"></select>
            <label style="font-size:0.9em">BW</label>
            <select class="wf-bandwidth" style="min-width:5.5rem"></select>
        </div>
        <div class="wf-cache-tabs" style="display:flex;gap:4px;flex-wrap:wrap;margin:0 0 6px"></div>
        <canvas class="wf-canvas" style="width:100%;background:#000;border-radius:4px;display:block"></canvas>
        <div class="wf-progress" hidden style="margin:6px 0 0">
            <div class="wf-progress-sections" hidden style="margin:0 0 6px">
                <div class="wf-progress-sections-label" style="font-size:0.8em;opacity:0.85;margin-bottom:2px">Sections</div>
                <div class="wf-progress-track" style="height:8px;background:#222;border-radius:4px;overflow:hidden">
                    <div class="wf-progress-sections-bar" style="height:100%;width:0%;background:#5a8a3a;transition:width 0.15s linear"></div>
                </div>
            </div>
            <div class="wf-progress-time">
                <div class="wf-progress-label" style="font-size:0.8em;opacity:0.85;margin-bottom:2px"></div>
                <div class="wf-progress-track" style="height:8px;background:#222;border-radius:4px;overflow:hidden">
                    <div class="wf-progress-bar" style="height:100%;width:0%;background:#3a7abd;transition:width 0.15s linear"></div>
                </div>
            </div>
        </div>
        <div class="wf-status" style="margin:8px 0;font-size:0.85em;min-height:1.2em;opacity:0.9"></div>
        <div class="cols" style="gap:8px;align-items:center;margin:0 0 4px">
            <div>
                {% if (supported) { %}
                <button class="wf-start">Start</button>
                <button class="wf-stop">Stop</button>
                <button class="wf-clear-cache">Clear cache</button>
                {% } %}
            </div>
            <div style="flex:1"></div>
            <a href="/a/waterfall" target="_blank" rel="noopener" style="font-size:0.85em">Open full page</a>
        </div>
    </div>
    {{_R("tool-footer")}}
    <script>
    (function () {
        const root = document.querySelector(".waterfall-tool");
        function mount() {
            if (root && window.WaterfallUI) {
                WaterfallUI.mount(root, { modal: true });
            }
        }
        /* Stop pollers when Done closes the dialog (tool-footer uses dialog.close()). */
        const modal = document.getElementById("ctrl-modal");
        if (modal) {
            modal.addEventListener("close", function () {
                if (root && root._wfDestroy) root._wfDestroy();
            }, { once: false });
        }
        if (window.WaterfallUI) {
            mount();
            return;
        }
        const s = document.createElement("script");
        s.src = "/waterfall/waterfall-ui.js?v={{wf.packageVersion()}}";
        s.onload = mount;
        s.onerror = function () {
            const st = root && root.querySelector(".wf-status");
            if (st) st.textContent = "Failed to load waterfall-ui.js";
        };
        document.head.appendChild(s);
    })();
    </script>
</div>
