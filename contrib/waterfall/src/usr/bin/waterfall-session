#!/bin/sh
# Bound waterfall session wrapper: records PID, always exits after worker.
# Invoked as: waterfall-session [-i iface] [-d secs]
set -e
IFACE=""
DUR=30
while [ $# -gt 0 ]; do
  case "$1" in
    -i) IFACE="$2"; shift 2 ;;
    -d) DUR="$2"; shift 2 ;;
    *) shift ;;
  esac
done
echo $$ > /tmp/waterfall-session.pid
ARGS="session -d $DUR"
[ -n "$IFACE" ] && ARGS="session -i $IFACE -d $DUR"
# shellcheck disable=SC2086
exec /usr/bin/waterfall $ARGS
