#!/bin/sh
# Interactive ash session without blocking CGI writers.
# Keystrokes are appended to infile; tail -f feeds them to ash.
# Usage: aredn-terminal-session <session-dir>
DIR="$1"
[ -n "$DIR" ] || exit 1
[ -d "$DIR" ] || exit 1

: > "$DIR/infile"
: > "$DIR/stdout"
date +%s > "$DIR/heartbeat"

# Pipeline: file follower -> ash. Track ash PID via a wrapper.
(
	# BusyBox: tail -f follows the infile as CGI appends to it.
	tail -f "$DIR/infile" 2>/dev/null | /bin/ash -l >>"$DIR/stdout" 2>&1 &
	# $! is ash (last process in pipeline for ash) on BusyBox — also save pipeline pgid.
	echo $! > "$DIR/pid"
	wait
) &
echo $! > "$DIR/wrapper"

# Wait until ash pid file exists.
i=0
while [ ! -s "$DIR/pid" ] && [ "$i" -lt 20 ]; do
	sleep 1
	i=$((i + 1))
done

# Stay alive while ash lives.
while kill -0 "$(cat "$DIR/pid" 2>/dev/null)" 2>/dev/null; do
	sleep 1
done
exit 0
