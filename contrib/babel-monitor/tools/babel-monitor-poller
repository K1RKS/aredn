#!/usr/bin/env python3
"""
Example babel-monitor poller (workstation / central server).

Commands:
  hello <node>   First-connect: GET meta; print identity; save state
  pull <node>    Incremental sync via saved cursor; append to local log
  status <node>  Show local cursor / hello fields / log path
  -h             Help

State and logs live under ~/.babel-monitor/ (override with BABEL_MONITOR_STATE).
"""
from __future__ import annotations

import gzip
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

STATE_ROOT = Path(os.environ.get("BABEL_MONITOR_STATE", Path.home() / ".babel-monitor"))


def usage() -> None:
    print(__doc__.strip())


def node_key(node: str) -> str:
    return node.replace("/", "_").replace(":", "_")


def state_path(node: str) -> Path:
    return STATE_ROOT / f"{node_key(node)}.json"


def log_path(node: str) -> Path:
    return STATE_ROOT / f"{node_key(node)}.log.jsonl"


def load_state(node: str) -> dict:
    p = state_path(node)
    if not p.exists():
        return {}
    return json.loads(p.read_text())


def save_state(node: str, st: dict) -> None:
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    state_path(node).write_text(json.dumps(st, indent=2) + "\n")


def api_base(node: str) -> str:
    if "://" in node:
        base = node.rstrip("/")
    else:
        base = f"http://{node}"
    if base.endswith("/cgi-bin/babel-monitor"):
        return base
    return f"{base}/cgi-bin/babel-monitor"


def fetch(node: str, params: dict) -> dict:
    q = urllib.parse.urlencode(params)
    url = f"{api_base(node)}?{q}"
    req = urllib.request.Request(url, headers={"Accept-Encoding": "gzip"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            enc = (resp.headers.get("Content-Encoding") or "").lower()
            if enc == "gzip" or raw[:2] == b"\x1f\x8b":
                raw = gzip.decompress(raw)
            return json.loads(raw.decode("utf-8"))
    except urllib.error.HTTPError as e:
        raise SystemExit(f"HTTP {e.code} from {url}: {e.reason}") from e
    except urllib.error.URLError as e:
        raise SystemExit(f"Failed to reach {url}: {e.reason}") from e


def cmd_hello(node: str) -> int:
    meta = fetch(node, {"api": "hello", "compress": "1"})
    st = load_state(node)
    st.update(
        {
            "node": node,
            "node_id": meta.get("node_id"),
            "mac": meta.get("mac"),
            "hostname": meta.get("hostname"),
            "boot_id": meta.get("boot_id"),
            "schema_version": meta.get("schema_version"),
            "since_seq": st.get("since_seq", 0),
            "log": str(log_path(node)),
        }
    )
    # New boot resets cursor
    if st.get("seen_boot_id") and st["seen_boot_id"] != meta.get("boot_id"):
        st["since_seq"] = 0
        st["gap_note"] = f"boot_id changed {st['seen_boot_id']} -> {meta.get('boot_id')}"
    st["seen_boot_id"] = meta.get("boot_id")
    save_state(node, st)
    print(f"node_id   {st.get('node_id')}")
    print(f"hostname  {st.get('hostname')}")
    print(f"mac       {st.get('mac')}")
    print(f"boot_id   {st.get('boot_id')}")
    print(f"schema    {st.get('schema_version')}")
    print(f"state     {state_path(node)}")
    return 0


def cmd_pull(node: str) -> int:
    st = load_state(node)
    if not st.get("boot_id"):
        cmd_hello(node)
        st = load_state(node)

    since = int(st.get("since_seq") or 0)
    data = fetch(
        node,
        {"api": "sync", "since_seq": str(since), "limit": "500", "compress": "1"},
    )

    boot = data.get("boot_id")
    if boot and st.get("seen_boot_id") and boot != st["seen_boot_id"]:
        print(f"boot_id changed; resetting cursor ({st['seen_boot_id']} -> {boot})")
        st["since_seq"] = 0
        st["seen_boot_id"] = boot
        st["gap_note"] = "boot_id changed on pull"
        save_state(node, st)
        data = fetch(
            node,
            {"api": "sync", "since_seq": "0", "limit": "500", "compress": "1"},
        )

    samples = data.get("samples") or []
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    lp = log_path(node)
    with lp.open("a") as fh:
        for s in samples:
            fh.write(json.dumps(s) + "\n")

    if samples:
        st["since_seq"] = samples[-1]["seq"]
    st["boot_id"] = data.get("boot_id") or st.get("boot_id")
    st["seen_boot_id"] = st.get("boot_id")
    st["last_truncated"] = data.get("truncated")
    st["last_gap_before"] = data.get("gap_before")
    st["last_complete"] = data.get("complete")
    st["log"] = str(lp)
    save_state(node, st)

    print(f"pulled {len(samples)} sample(s); since_seq={st['since_seq']} truncated={data.get('truncated')}")
    print(f"log {lp}")
    return 0


def cmd_status(node: str) -> int:
    st = load_state(node)
    if not st:
        print(f"No local state for {node} ({state_path(node)} missing)")
        return 1
    for k in (
        "node",
        "node_id",
        "hostname",
        "mac",
        "boot_id",
        "seen_boot_id",
        "since_seq",
        "last_truncated",
        "last_complete",
        "gap_note",
        "log",
    ):
        if k in st:
            print(f"{k:16} {st[k]}")
    print(f"{'state':16} {state_path(node)}")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    cmd = argv[0]
    if cmd not in ("hello", "pull", "status"):
        print(f"Unknown command: {cmd}", file=sys.stderr)
        usage()
        return 1
    if len(argv) < 2:
        print(f"{cmd} requires <node>", file=sys.stderr)
        return 1
    node = argv[1]
    if cmd == "hello":
        return cmd_hello(node)
    if cmd == "pull":
        return cmd_pull(node)
    return cmd_status(node)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
